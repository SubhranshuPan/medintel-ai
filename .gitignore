.claude/*
!.claude/skills/
# Reviewer agents vendored from the ECC plugin (MIT) — see .claude/agents/README.md.
# Tracked so a fresh clone has them without re-copying from a local plugin cache.
!.claude/agents/

# Environment files anywhere in the tree. backend/ and frontend/ ignore their
# own, but a stray root-level .env was previously committable.
.env
.env.*
!.env.example

# Root-level Obsidian vault (local editor state, not project code)
.obsidian/

# Obsidian local UI state inside .ai vault (noisy diffs, machine-specific)
# Keep app.json/appearance.json/community-plugins.json/core-plugins.json tracked
.ai/.obsidian/workspace.json
.ai/.obsidian/workspace-mobile.json
.ai/.obsidian/graph.json

# Personal Claude Code overrides (not shared)
.claude/settings.local.json

# Uploaded dataset objects. backend/.gitignore already covers the Docker layout
# (cwd=/app); running uvicorn locally from the repo root puts them here instead.
/storage/
